version: '3.8'

services:
  # MongoDB Service
  mongodb:
    image: mongo:latest
    container_name: mongodb
    environment:
      MONGO_INITDB_ROOT_USERNAME: root
      MONGO_INITDB_ROOT_PASSWORD: example
    volumes:
      - ./mongodb_data:/data/db
    ports:
      - '27017:27017'
    restart: unless-stopped
    networks:
      - app-network

  # Your Application Service
  app:
    build: .
    container_name: app
    ports:
      - '5000:5000'
    environment:
      - MONGO_URI=mongodb://root:example@mongodb:27017
      - PORT=5000
      - DEFAULT_ADMIN_USERNAME=admin
      - DEFAULT_ADMIN_PASSWORD=admin
      - JWT_SECRET=your_very_strong_jwt_secret_here
      - BASE_URL=http://172.16.200.100:8080/
      - EXTERNAL_UPLOADS_DIR=/app/uploads
    volumes:
      - uploads:/app/uploads
    depends_on:
      - mongodb
    restart: unless-stopped
    networks:
      - app-network
    healthcheck:
      test: ['CMD', 'curl', '-f', 'http://localhost:5000']
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 5s

  # Nginx File Server
  nginx-fileserver:
    image: nginx:latest
    container_name: nginx-fileserver
    ports:
      - '8080:80'
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/conf.d/default.conf
      - uploads:/usr/share/nginx/html
    depends_on:
      - app
    restart: unless-stopped
    networks:
      - app-network

volumes:
  mongodb_data:
    driver: local
  uploads:
    driver: local
    driver_opts:
      type: none
      device: /home/fiamanillah/Documents/uploads
      o: bind

networks:
  app-network:
    driver: bridge
