<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.6;
            color: #333;
            max-width: 1200px;
            margin: 0 auto;
            padding: 20px;
            background-color: #f5f5f5;
        }
        h1 {
            color: #2c3e50;
            border-bottom: 2px solid #3498db;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .api-key-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            box-shadow: 0 2px 3px rgba(0,0,0,0.1);
            background-color: white;
        }
        .api-key-table th, .api-key-table td {
            padding: 12px 15px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .api-key-table th {
            background-color: #3498db;
            color: white;
            font-weight: bold;
        }
        .api-key-table tr:hover {
            background-color: #f1f9ff;
        }
        .key-cell {
            font-family: monospace;
            color: #e74c3c;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .key-text {
            flex-grow: 1;
        }
        .permission-tag {
            display: inline-block;
            background-color: #e0f7fa;
            color: #00838f;
            padding: 3px 8px;
            border-radius: 3px;
            margin-right: 5px;
            margin-bottom: 5px;
            font-size: 0.8em;
        }
        .action-btn {
            padding: 5px 10px;
            border: none;
            border-radius: 3px;
            cursor: pointer;
            font-size: 0.9em;
            margin-right: 5px;
            transition: all 0.2s;
        }
        .copy-btn {
            background-color: #3498db;
            color: white;
        }
        .copy-btn:hover {
            background-color: #2980b9;
        }
        .copy-btn.copied {
            background-color: #2ecc71;
        }
        .revoke-btn {
            background-color: #e74c3c;
            color: white;
        }
        .revoke-btn:hover {
            background-color: #c0392b;
        }
        .no-keys {
            text-align: center;
            padding: 20px;
            color: #7f8c8d;
            font-style: italic;
        }
        .header-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }
        .generate-btn {
            background-color: #2ecc71;
            color: white;
            padding: 10px 15px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .generate-btn:hover {
            background-color: #27ae60;
        }
        .actions-cell {
            display: flex;
            gap: 5px;
        }
    </style>
</head>
<body>
    <div class="header-actions">
        <h1><%= heading %></h1>
        <button class="generate-btn" onclick="location.href='/api/keys/generateApiKey'">Generate New Key</button>
    </div>

    <% if (apiKeys.length > 0) { %>
        <table class="api-key-table">
            <thead>
                <tr>
                    <th>Service Name</th>
                    <th>API Key</th>
                    <th>Permissions</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% apiKeys.forEach(function(key) { %>
                    <tr>
                        <td><%= key.serviceName %></td>
                        <td class="key-cell">
                            <span class="key-text"><%= key.key %></span>
                            <button class="action-btn copy-btn" onclick="copyToClipboard(this, '<%= key.key %>')">Copy</button>
                        </td>
                        <td>
                            <% key.permissions.forEach(function(permission) { %>
                                <span class="permission-tag"><%= permission %></span>
                            <% }); %>
                        </td>
                        <td class="actions-cell">
                            <button class="action-btn revoke-btn" 
                                    onclick="revokeKey('<%= key.key %>')">Revoke</button>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    <% } else { %>
        <div class="no-keys">No active API keys found. Generate one to get started.</div>
    <% } %>

    <script>
        function copyToClipboard(button, text) {
            navigator.clipboard.writeText(text).then(() => {
                // Change button text and style temporarily
                const originalText = button.textContent;
                button.textContent = 'Copied!';
                button.classList.add('copied');
                
                // Reset after 2 seconds
                setTimeout(() => {
                    button.textContent = originalText;
                    button.classList.remove('copied');
                }, 2000);
            }).catch(err => {
                console.error('Failed to copy text: ', err);
                alert('Failed to copy API key to clipboard');
            });
        }

        function revokeKey(key) {
            if (confirm('Are you sure you want to revoke this API key? This action cannot be undone.')) {
                fetch(`/api/keys/${key}`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                })
                .then(response => {
                    if (response.ok) {
                        alert('API key revoked successfully');
                        location.reload();
                    } else {
                        alert('Failed to revoke API key');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('An error occurred while revoking the API key');
                });
            }
        }
    </script>
</body>
</html>