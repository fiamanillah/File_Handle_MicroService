<!DOCTYPE html>

<html>
<head>
    <title><%= title %></title>
</head>
<body>
    <h1><%= heading %></h1>
    
    <% if (userLoggedIn) { %>
        <p>Welcome back, <%= username %>!</p>
    <% } else { %>
        <p>Please log in.</p>
    <% } %>
    
    <ul>
        <% items.forEach(item => { %>
            <li><%= item.name %></li>
        <% }); %>
    </ul>
</body>
</html>